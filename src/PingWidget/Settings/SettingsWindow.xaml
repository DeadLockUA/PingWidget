<Window x:Class="PingWidget.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PingWidget — настройки"
        Width="440" Height="540" MinWidth="400" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap"
                   Text="Адреса для пинга и порог в миллисекундах: выше порога линия становится красной." />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Сохранить" Width="90" Margin="0,0,8,0" IsDefault="True" Click="OnSave" />
            <Button Content="Отмена" Width="90" IsCancel="True" />
        </StackPanel>

        <TextBlock x:Name="Errors" DockPanel.Dock="Bottom" Foreground="#d32f2f" TextWrapping="Wrap"
                   Margin="0,8,0,0" Visibility="Collapsed" />

        <GroupBox DockPanel.Dock="Bottom" Header="Пороги железа" Margin="0,10,0,0" Padding="6">
            <UniformGrid x:Name="ThresholdGrid" Columns="2" />
        </GroupBox>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Добавить" Width="90" Margin="0,0,8,0" Click="OnAdd" />
            <Button Content="Удалить" Width="90" Click="OnRemove" />
        </StackPanel>

        <DataGrid x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserResizeRows="False" HeadersVisibility="Column" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Адрес" Width="*"
                                    Binding="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Header="Порог, мс" Width="100"
                                    Binding="{Binding Threshold, UpdateSourceTrigger=PropertyChanged}" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
